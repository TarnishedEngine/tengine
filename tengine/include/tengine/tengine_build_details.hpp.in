/**
 * @file tengine_build_details.hpp
 * @brief Template header that contains build details. Filled in by CMake when building.
 * @author DIY Labs
 */

#pragma once

#include <string>
#include <iostream>
#include <fmt/format.h>

namespace tengine::build_details{

inline constexpr int BUILD_VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
inline constexpr int BUILD_VERSION_MINOR = @PROJECT_VERSION_MINOR@;
inline constexpr int BUILD_VERSION_PATCH = @PROJECT_VERSION_PATCH@;

inline const std::string BUILD_VERSION_STRING = "@PROJECT_VERSION@";
inline const std::string BUILD_ENGINE_NAME = "@PROJECT_NAME@";

inline const std::string BUILD_TIMESTAMP = "@TENGINE_BUILD_TIME@";
inline const std::string BUILD_NOTES = "@TENGINE_BUILD_NOTES@";
inline const std::string BUILD_TYPE = "@TENGINE_BUILD_TYPE@";
inline const std::string SYSTEM_NAME = "@TENGINE_PLATFORM@";
inline const std::string SYSTEM_ARCHITECTURE = "@TENGINE_ARCH@";

inline const std::string TENGINE_LICENSE = R"(@TENGINE_LICENSE@)";
inline const std::string THIRDPARTY_LICENSES = R"(@THIRDPARTY_LICENSES@)";

/**
 * @brief Returns build details in a formatted string
*/
inline std::string getFormattedBuildDetails(){

    return fmt::format(
    "{} version {} build type {}.\n"
    "{}\n"
    "Compiled at {} on {} - {}"
    "\n\n"
    "{}\n"
    "{}"
    "\n\n",
    tengine::build_details::BUILD_ENGINE_NAME, tengine::build_details::BUILD_VERSION_STRING, tengine::build_details::BUILD_TYPE,
    tengine::build_details::BUILD_NOTES,
    tengine::build_details::BUILD_TIMESTAMP, tengine::build_details::SYSTEM_NAME, tengine::build_details::SYSTEM_ARCHITECTURE,
    tengine::build_details::TENGINE_LICENSE,
    tengine::build_details::THIRDPARTY_LICENSES
    );

}

/**
 * @brief Prints build details to standard output.
 */
inline void printBuildDetails(){

    std::cout << getFormattedBuildDetails();

}

}