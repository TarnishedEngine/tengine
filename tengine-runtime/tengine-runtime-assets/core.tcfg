// Core config file for the Tarnished Runtime.
// The path to this file is hard-coded into the runtime
// -DIY Labs

tr_core_config{

    // Directories to search for config files
    // Relative to the runtime executable
    search_path{
        "path" = "tengine-runtime-assets"
    }

    // File extension associations to make ('.' required)
    // - configFile: extension to use when searching for config files
    file_extensions{
        "configFile" = ".tcfg"
    }

}